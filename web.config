<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <rule name="RewriteRule Cephalo-Proxy">
                    <match url="(.*)" />
                    <action type="Rewrite" url="http://cephalo.tricell.local:3000/{R:1}" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>

